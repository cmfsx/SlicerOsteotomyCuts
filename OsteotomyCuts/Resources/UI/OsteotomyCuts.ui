<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>OsteotomyCuts</class>
 <widget class="qMRMLWidget" name="OsteotomyCuts">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>360</width>
    <height>620</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="ctkCollapsibleButton" name="inputsCollapsibleButton">
     <property name="text">
      <string>Inputs</string>
     </property>
     <layout class="QFormLayout" name="inputsFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="inputModelLabel">
        <property name="text">
         <string>Model to cut:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="qMRMLNodeComboBox" name="inputModelSelector">
        <property name="toolTip">
         <string>Bone model to cut. This may also be a fragment from an earlier cut.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLModelNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>inputModel</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="cutCurveLabel">
        <property name="text">
         <string>Cut path:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="qMRMLNodeComboBox" name="cutCurveSelector">
        <property name="toolTip">
         <string>Markups curve whose points are placed on the bone surface along the osteotomy.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsCurveNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>true</bool>
        </property>
        <property name="baseName">
         <string>Cut</string>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
        <property name="renameEnabled">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>cutCurve</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="qSlicerMarkupsPlaceWidget" name="cutCurvePlaceWidget">
        <property name="toolTip">
         <string>Place points of the cut path on the bone surface.</string>
        </property>
        <property name="placeMultipleMarkups">
         <enum>qSlicerMarkupsPlaceWidget::ForcePlaceMultipleMarkups</enum>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="groupLinesLabel">
        <property name="text">
         <string>Further lines:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="qMRMLCheckableNodeComboBox" name="groupLinesSelector">
        <property name="toolTip">
         <string>Other cut paths cut together with this one in one step, as one osteotomy (e.g. the pterygomaxillary cuts of a Le Fort I). They are cut in the order they are ticked, after the first line; each later line only cuts on its own side of the earlier lines, so it stops where it meets them. Each line keeps its own direction and saw settings: select it as the cut path to set them.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsCurveNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QLabel" name="groupOrderLabel">
        <property name="text">
         <string/>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="snapToSurfaceLabel">
        <property name="text">
         <string>Snap to surface:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QCheckBox" name="snapToSurfaceCheckBox">
        <property name="toolTip">
         <string>Keep the cut path points on the surface of the model to cut.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>snapToSurface</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="treatBoneAsSolidLabel">
        <property name="text">
         <string>Treat bone as solid:</string>
        </property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="treatBoneAsSolidCheckBox">
        <property name="toolTip">
         <string>Cut a solid version of the bone: holes in the surface are sealed and internal surfaces (marrow, canals, inner side of the cortex) are filled, so that the cut separates the bone cleanly into closed segments. The surface is rebuilt at the solid model detail (Advanced), which moves it by about that much. The first cut of a model takes a few seconds longer. Models made with "Create solid bone model" and segments of a solid cut are used as they are.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>treatBoneAsSolid</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QPushButton" name="createSolidButton">
        <property name="toolTip">
         <string>Create a solid copy of the model to cut (named "..._solid"), seal its holes and fill its internal surfaces, and select it for cutting. The original model is hidden, not changed.</string>
        </property>
        <property name="text">
         <string>Create solid bone model</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="directionCollapsibleButton">
     <property name="text">
      <string>Extrusion direction</string>
     </property>
     <layout class="QGridLayout" name="directionGridLayout">
      <item row="0" column="0">
       <widget class="QRadioButton" name="directionViewRadioButton">
        <property name="toolTip">
         <string>Extrude the cut path along the viewing direction of the 3D view, captured when the button is pressed.</string>
        </property>
        <property name="text">
         <string>Current 3D view</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QPushButton" name="captureViewDirectionButton">
        <property name="toolTip">
         <string>Store the current viewing direction of the first 3D view as the extrusion direction.</string>
        </property>
        <property name="text">
         <string>Capture view direction</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLabel" name="viewDirectionLabel">
        <property name="text">
         <string>Not captured</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QRadioButton" name="directionLineRadioButton">
        <property name="toolTip">
         <string>Extrude the cut path along a markups line. Place its first point outside the bone and its second point towards the inside: the cut depth is measured in that direction.</string>
        </property>
        <property name="text">
         <string>Markups line</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="qMRMLNodeComboBox" name="directionLineSelector">
        <property name="toolTip">
         <string>Markups line defining the extrusion direction.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsLineNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="baseName">
         <string>CutDirection</string>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
        <property name="renameEnabled">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>directionLine</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="qSlicerMarkupsPlaceWidget" name="directionLinePlaceWidget">
        <property name="toolTip">
         <string>Place the two points of the direction line.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="sawCollapsibleButton">
     <property name="text">
      <string>Saw</string>
     </property>
     <layout class="QFormLayout" name="sawFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="kerfWidthLabel">
        <property name="text">
         <string>Kerf width:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkDoubleSpinBox" name="kerfWidthSpinBox">
        <property name="toolTip">
         <string>Width of bone removed by the saw blade (typically about 1.0 mm for an oscillating saw, 0.3-0.5 mm for a piezo insert). 0 gives a zero-width cut.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.kerfWidth</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="depthLabel">
        <property name="text">
         <string>Cut depth (0 = through):</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkDoubleSpinBox" name="depthSpinBox">
        <property name="toolTip">
         <string>How deep the cut goes from the path points along the extrusion direction. 0 cuts through the whole model. Set a depth whenever other bone lies behind the cut (e.g. about 45-55 mm for a Le Fort I cut, so that it stops at the pterygoid plates). With a kerf width of 0 a limited cut removes a 0.1 mm layer.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>1000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.depth</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="endExtensionLabel">
        <property name="text">
         <string>Past line ends (0 = auto):</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="ctkDoubleSpinBox" name="endExtensionSpinBox">
        <property name="toolTip">
         <string>How far the cut continues past the first and last points of the cut path. 0 continues it right through the model. Set a few millimetres to stop the cut beyond the ends of the line, in a gap between bones, so that bone farther away is not cut (e.g. 5-10 mm past the zygomatic buttresses for a Le Fort I cut). The cut must leave the bone there: a cut ending inside the bone is refused. With a kerf width of 0 a limited cut removes a 0.1 mm layer.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>1.000000000000000</double>
        </property>
        <property name="maximum">
         <double>10000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.endExtension</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="capCutFacesLabel">
        <property name="text">
         <string>Cap cut faces:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="capCutFacesCheckBox">
        <property name="toolTip">
         <string>Close the cut faces so that the fragments are watertight (needed for STL export and printing).</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.capCutFaces</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="previewCollapsibleButton">
     <property name="text">
      <string>Preview</string>
     </property>
     <layout class="QFormLayout" name="previewFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="livePreviewLabel">
        <property name="text">
         <string>Live preview:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="livePreviewCheckBox">
        <property name="toolTip">
         <string>Show the cutting sheet and update it while the points are moved.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>livePreview</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="sheetOpacityLabel">
        <property name="text">
         <string>Sheet opacity:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkSliderWidget" name="sheetOpacitySliderWidget">
        <property name="toolTip">
         <string>Opacity of the cutting sheet preview.</string>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="value">
         <double>0.400000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="advancedCollapsibleButton">
     <property name="text">
      <string>Advanced</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="advancedFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="extensionLabel">
        <property name="text">
         <string>Sheet extension (mm, 0 = auto):</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkDoubleSpinBox" name="extensionSpinBox">
        <property name="toolTip">
         <string>How far the cutting sheet reaches out of the bone (against the extrusion direction), and into it when the cut depth is 0 and past the line ends when "Past line ends" is 0. 0 uses the model's bounding-box diagonal, which always cuts fully through. To stop a cut inside the bone, set the cut depth and "Past line ends" instead.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="maximum">
         <double>10000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.extension</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="minFragmentFractionLabel">
        <property name="text">
         <string>Min. fragment size (fraction):</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkDoubleSpinBox" name="minFragmentFractionSpinBox">
        <property name="toolTip">
         <string>Free-standing pieces with fewer points than this fraction of the model are discarded. Enclosed pieces (canal, marrow voids) are always kept.</string>
        </property>
        <property name="decimals">
         <number>4</number>
        </property>
        <property name="singleStep">
         <double>0.001000000000000</double>
        </property>
        <property name="maximum">
         <double>0.500000000000000</double>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.minFragmentFraction</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="refineEdgeLengthLabel">
        <property name="text">
         <string>Max. edge near cut (0 = auto):</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="ctkDoubleSpinBox" name="refineEdgeLengthSpinBox">
        <property name="toolTip">
         <string>Mesh edges near the cut are subdivided until they are shorter than this, so the kerf faces are accurate. 0 uses half the kerf width.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.refineEdgeLength</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="solidVoxelSizeLabel">
        <property name="text">
         <string>Solid model detail:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="ctkDoubleSpinBox" name="solidVoxelSizeSpinBox">
        <property name="toolTip">
         <string>Size of the smallest detail kept in solid bone models (voxel size). Typical: 0.25 mm for a mandible, 0.4-0.5 mm for a whole skull (finer needs more memory; a model too large for the detail is refused with a suggested value).</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="minimum">
         <double>0.050000000000000</double>
        </property>
        <property name="maximum">
         <double>5.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>solidVoxelSize</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="solidGapSealLabel">
        <property name="text">
         <string>Solid model gap sealing:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="ctkDoubleSpinBox" name="solidGapSealSpinBox">
        <property name="toolTip">
         <string>Holes and gaps in the bone surface up to about twice this width are sealed in solid bone models (morphological closing radius). Typical: 1.5 mm. Larger values also fill narrow gaps between bones and sharp notches.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>solidGapSeal</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="applyButtonsLayout">
     <item>
      <widget class="QPushButton" name="applyButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>Cut the model along the cutting sheet.</string>
       </property>
       <property name="text">
        <string>Apply cut</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="undoButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>Remove the fragments produced by the selected cut path and show its input model again.</string>
       </property>
       <property name="text">
        <string>Undo cut (this curve)</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text">
      <string/>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="mergeCollapsibleButton">
     <property name="text">
      <string>Merge fragments</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QHBoxLayout" name="mergeLayout">
      <item>
       <widget class="qMRMLCheckableNodeComboBox" name="mergeFragmentsSelector">
        <property name="toolTip">
         <string>Tick two or more fragments from the same cut to join them into one model.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLModelNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="mergeButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Join the ticked fragments into one model.</string>
        </property>
        <property name="text">
         <string>Merge selected</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
