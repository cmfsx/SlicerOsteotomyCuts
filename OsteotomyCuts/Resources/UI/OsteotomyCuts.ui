<!-- Part of OsteotomyCuts, a 3D Slicer extension. See LICENSE and DISCLAIMER.md. -->
<ui version="4.0">
 <class>OsteotomyCuts</class>
 <widget class="qMRMLWidget" name="OsteotomyCuts">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>360</width>
    <height>620</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QPushButton" name="showTermsButton">
     <property name="visible">
      <bool>false</bool>
     </property>
     <property name="toolTip">
      <string>The module can be used once its terms of use are accepted.
Typical: read them once for each new version of the module.
Technical: stored in the application settings (OsteotomyCuts/DisclaimerAcceptedVersion).</string>
     </property>
     <property name="text">
      <string>Read and accept the terms of use to start</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="inputsCollapsibleButton">
     <property name="text">
      <string>1. Bone and osteotomy line</string>
     </property>
     <layout class="QFormLayout" name="inputsFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="inputModelLabel">
        <property name="text">
         <string>Bone to cut:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="qMRMLNodeComboBox" name="inputModelSelector">
        <property name="toolTip">
         <string>The bone model to divide. It can also be a bone segment from an earlier cut.
Typical: the mandible, or the maxilla and skull, from segmentation.
Technical: a model node; the original is hidden, never modified.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLModelNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>inputModel</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="cutCurveLabel">
        <property name="text">
         <string>Osteotomy line:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="qMRMLNodeComboBox" name="cutCurveSelector">
        <property name="toolTip">
         <string>The line along which the bone is cut: click points on the bone surface where you would mark the osteotomy in theatre. Each line keeps its own saw direction and cut limits.
Typical: 3 to 10 points; each point adds a corner.
Technical: a (linear) markups curve, extruded along the saw direction into the cutting surface (sheet).</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsCurveNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>true</bool>
        </property>
        <property name="baseName">
         <string>Cut</string>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
        <property name="renameEnabled">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>cutCurve</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="qSlicerMarkupsPlaceWidget" name="cutCurvePlaceWidget">
        <property name="toolTip">
         <string>Click on the bone to place the points of the osteotomy line.
Typical: place them in order along the planned cut.
Technical: markups place mode for the selected curve.</string>
        </property>
        <property name="placeMultipleMarkups">
         <enum>qSlicerMarkupsPlaceWidget::ForcePlaceMultipleMarkups</enum>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="groupLinesLabel">
        <property name="text">
         <string>Further osteotomy lines:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="qMRMLCheckableNodeComboBox" name="groupLinesSelector">
        <property name="toolTip">
         <string>Other osteotomy lines cut together with this one in one step, as one osteotomy (e.g. the pterygomaxillary cuts of a Le Fort I). Each later line stops where it meets an earlier one.
Typical: the lines of one osteotomy, ticked in the order they should be cut.
Technical: lines are applied in order; a later line only removes bone on its own side of the earlier lines' cutting surfaces.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsCurveNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QLabel" name="groupOrderLabel">
        <property name="text">
         <string />
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="snapToSurfaceLabel">
        <property name="text">
         <string>Keep points on the bone:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QCheckBox" name="snapToSurfaceCheckBox">
        <property name="toolTip">
         <string>Moves the points of the osteotomy lines onto the bone surface after they are placed or moved.
Typical: on.
Technical: control points are snapped to the closest point of the model surface.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>snapToSurface</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QLabel" name="treatBoneAsSolidLabel">
        <property name="text">
         <string>Treat bone as solid:</string>
        </property>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="treatBoneAsSolidCheckBox">
        <property name="toolTip">
         <string>Cuts a solid version of the bone: holes are sealed and internal surfaces (marrow, canals, inner cortex) are filled, so the bone divides cleanly into closed bone segments. Models made with "Create solid bone model", and segments of a solid cut, are used as they are.
Typical: on; the first cut of a bone takes a few seconds longer, and its surface moves by up to about half the solid model detail (Advanced).
Technical: the surface is voxelised, closed morphologically, cavities filled and re-meshed (flying edges, windowed sinc smoothing).</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>treatBoneAsSolid</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QPushButton" name="createSolidButton">
        <property name="toolTip">
         <string>Makes a solid copy of the bone (named "..._solid") with holes sealed and internal surfaces filled, and selects it for cutting. The original model is hidden, not changed.
Typical: once per bone model from segmentation.
Technical: as "Treat bone as solid"; the copy is marked solid.</string>
        </property>
        <property name="text">
         <string>Create solid bone model</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="directionCollapsibleButton">
     <property name="text">
      <string>2. Saw direction</string>
     </property>
     <layout class="QGridLayout" name="directionGridLayout">
      <item row="0" column="0">
       <widget class="QRadioButton" name="directionViewRadioButton">
        <property name="toolTip">
         <string>The saw direction is the direction you look along in the 3D view when you press "Set saw direction from view".
Typical: rotate the view to look the way you would hold the saw.
Technical: the camera's direction of projection, stored when set (extrusion direction).</string>
        </property>
        <property name="text">
         <string>From 3D view</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QPushButton" name="captureViewDirectionButton">
        <property name="toolTip">
         <string>Stores the current viewing direction of the 3D view as the saw direction of the selected osteotomy line.
Typical: press again after rotating the view to change it.
Technical: captures the direction of projection of the first 3D view.</string>
        </property>
        <property name="text">
         <string>Set saw direction from view</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLabel" name="viewDirectionLabel">
        <property name="text">
         <string>Not set</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QRadioButton" name="directionLineRadioButton">
        <property name="toolTip">
         <string>The saw direction follows a line you draw: first point outside the bone, second point towards the inside. Gives a precise, reproducible angle.
Typical: for exact angles.
Technical: markups line, point 1 to point 2; the cut depth is measured along it.</string>
        </property>
        <property name="text">
         <string>Direction line</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="qMRMLNodeComboBox" name="directionLineSelector">
        <property name="toolTip">
         <string>The line that sets the saw direction.
Typical: two points, from outside to inside the bone.
Technical: markups line node.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLMarkupsLineNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="baseName">
         <string>CutDirection</string>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
        <property name="renameEnabled">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>directionLine</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="qSlicerMarkupsPlaceWidget" name="directionLinePlaceWidget">
        <property name="toolTip">
         <string>Place the two points of the direction line.
Typical: first outside the bone, then inside.
Technical: markups place mode.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="sawCollapsibleButton">
     <property name="text">
      <string>3. Saw and cut limits</string>
     </property>
     <layout class="QFormLayout" name="sawFormLayout">
      <item row="0" column="0"><widget class="QLabel" name="bladePresetLabel"><property name="text"><string>Saw blade:</string></property></widget></item><item row="0" column="1"><widget class="QComboBox" name="bladePresetComboBox"><property name="toolTip"><string>Choose the saw blade; this sets the saw blade thickness below.
Typical: "Standard blade (1.0 mm)" for an oscillating saw.
Technical: presets of the kerf width; "Custom" when another thickness is typed.</string></property><item><property name="text"><string>Ideal cut (no bone lost)</string></property></item><item><property name="text"><string>Thin blade (0.5 mm)</string></property></item><item><property name="text"><string>Standard blade (1.0 mm)</string></property></item><item><property name="text"><string>Custom</string></property></item></widget></item><item row="1" column="0">
       <widget class="QLabel" name="kerfWidthLabel">
        <property name="text">
         <string>Saw blade thickness:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkDoubleSpinBox" name="kerfWidthSpinBox">
        <property name="toolTip">
         <string>Thickness of bone removed by the saw. Choosing a blade above sets it; typing a value chooses "Custom".
Typical: 1.0 mm for an oscillating saw, 0.5 mm for a thin blade, 0.3-0.5 mm for a piezo insert; 0 is an ideal cut with no bone lost.
Technical: kerf width: bone closer than half of it to the cutting surface is removed.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.kerfWidth</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="depthLabel">
        <property name="text">
         <string>Cut depth:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="ctkDoubleSpinBox" name="depthSpinBox">
        <property name="toolTip">
         <string>How far the saw goes into the bone from the osteotomy line, along the saw direction.
Typical: "Through" (0) for a complete cut; about 45-55 mm for a Le Fort I, to the pterygoid plates.
Technical: depth of the cutting surface along the extrusion direction; a limited cut with the ideal blade removes a 0.1 mm layer.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>1000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.depth</string>
        </property>
       <property name="specialValueText"><string>Through</string></property></widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="endExtensionLabel">
        <property name="text">
         <string>Cut reach beyond the line:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="ctkDoubleSpinBox" name="endExtensionSpinBox">
        <property name="toolTip">
         <string>How far the cut continues past the first and last points of the osteotomy line. The cut must leave the bone there: a cut ending inside bone is refused.
Typical: "Automatic" (0) cuts right through; 5-10 mm stops it in a gap between bones (e.g. past the zygomatic buttresses).
Technical: end extension of the cutting surface along the end tangents.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>1.000000000000000</double>
        </property>
        <property name="maximum">
         <double>10000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.endExtension</string>
        </property>
       <property name="specialValueText"><string>Automatic</string></property></widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="capCutFacesLabel">
        <property name="text">
         <string>Close cut surfaces:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QCheckBox" name="capCutFacesCheckBox">
        <property name="toolTip">
         <string>Closes the cut surfaces so that every bone segment is a closed (watertight) model, as needed for 3D printing and volumes.
Typical: on.
Technical: the cut faces are capped by triangulating their rim loops on the cutting surface.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.capCutFaces</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="structuresCollapsibleButton">
     <property name="text">
      <string>4. Structures to protect</string>
     </property>
     <layout class="QGridLayout" name="structuresGridLayout">
      <item row="0" column="0" colspan="2">
       <widget class="qMRMLNodeComboBox" name="structureNodeSelector">
        <property name="toolTip">
         <string>A model (e.g. the mandibular canal or the teeth) or a curve along a nerve, to keep clear of the cut.
Typical: the canal and tooth models from segmentation.
Technical: model node, or markups curve with a radius.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLModelNode</string>
          <string>vtkMRMLMarkupsCurveNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>true</bool>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QPushButton" name="addStructureButton">
        <property name="toolTip">
         <string>Adds the chosen model or curve to the structures to protect. Its type is guessed from its name (nerve / canal, tooth / teeth) and can be changed below.
Typical: add the nerve canal and the teeth.
Technical: stores the settings as an attribute of the node.</string>
        </property>
        <property name="text">
         <string>Add</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="3">
       <widget class="QTableWidget" name="structuresTable">
        <property name="toolTip">
         <string>How close the planned cut comes to each structure, inside the bone, allowing for the saw blade thickness. Select a row to change its settings.
Typical: every status "Safe" before cutting.
Technical: minimum signed distance from the cutting surface (sampled to 0.1 mm) to the structure.</string>
        </property>
        <property name="editTriggers">
         <set>QAbstractItemView::NoEditTriggers</set>
        </property>
        <property name="selectionMode">
         <enum>QAbstractItemView::SingleSelection</enum>
        </property>
        <property name="selectionBehavior">
         <enum>QAbstractItemView::SelectRows</enum>
        </property>
        <property name="columnCount">
         <number>5</number>
        </property>
        <attribute name="horizontalHeaderStretchLastSection">
         <bool>true</bool>
        </attribute>
        <attribute name="verticalHeaderVisible">
         <bool>false</bool>
        </attribute>
        <column>
         <property name="text">
          <string>Structure</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Type</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Safe distance</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Distance to cut</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Status</string>
         </property>
        </column>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="structureCategoryLabel">
        <property name="text">
         <string>Type:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1" colspan="2">
       <widget class="QComboBox" name="structureCategoryComboBox">
        <property name="toolTip">
         <string>Kind of structure. Choosing it sets its usual safe distance.
Typical: nerve 2 mm, tooth root 1 mm, other 1 mm.
Technical: structure category.</string>
        </property>
        <item>
         <property name="text">
          <string>Nerve</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Tooth root</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Other</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="structureSafeDistanceLabel">
        <property name="text">
         <string>Safe distance:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1" colspan="2">
       <widget class="ctkDoubleSpinBox" name="structureSafeDistanceSpinBox">
        <property name="toolTip">
         <string>The cut should stay at least this far from the structure. Closer gives "Too close"; into the structure gives "Cut enters structure".
Typical: 2 mm from the inferior alveolar nerve, 1 mm from tooth roots.
Technical: clearance threshold.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>20.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="structureRadiusLabel">
        <property name="text">
         <string>Radius (curve):</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1" colspan="2">
       <widget class="ctkDoubleSpinBox" name="structureRadiusSpinBox">
        <property name="toolTip">
         <string>For a structure traced as a curve along its centre (e.g. the nerve): its radius.
Typical: 1.5 mm for the inferior alveolar canal.
Technical: the structure is a tube of this radius round the curve.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0" colspan="3">
       <widget class="QCheckBox" name="structureEnabledCheckBox">
        <property name="toolTip">
         <string>Check the distance from the cut to this structure.
Typical: on.
Technical: structures switched off are not checked.</string>
        </property>
        <property name="text">
         <string>Check this structure</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QPushButton" name="checkDistancesButton">
        <property name="toolTip">
         <string>Measures how close the cut comes to each structure now. This is also done before every cut, and during the cut preview.
Typical: after changing the plan.
Technical: clearance check of all lines of the osteotomy.</string>
        </property>
        <property name="text">
         <string>Check distances</string>
        </property>
       </widget>
      </item>
      <item row="6" column="2">
       <widget class="QPushButton" name="removeStructureButton">
        <property name="toolTip">
         <string>Stops protecting the selected structure; its model or curve is kept.
Typical: 
Technical: removes the attribute from the node.</string>
        </property>
        <property name="text">
         <string>Remove</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0" colspan="3">
       <widget class="QLabel" name="structuresStatusLabel">
        <property name="text">
         <string />
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="previewCollapsibleButton">
     <property name="text">
      <string>Preview</string>
     </property>
     <layout class="QFormLayout" name="previewFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="livePreviewLabel">
        <property name="text">
         <string>Show cut preview:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="livePreviewCheckBox">
        <property name="toolTip">
         <string>Shows the planned cut (red transparent surface) and red lines wherever it comes out of the bone, updated as points move.
Typical: on.
Technical: cutting sheet preview and sheet/bone intersection outline.</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>livePreview</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="sheetOpacityLabel">
        <property name="text">
         <string>Preview opacity:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkSliderWidget" name="sheetOpacitySliderWidget">
        <property name="toolTip">
         <string>How transparent the cut preview is.
Typical: 0.4.
Technical: opacity of the cutting sheet model.</string>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="value">
         <double>0.400000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="advancedCollapsibleButton">
     <property name="text">
      <string>Advanced</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="advancedFormLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="extensionLabel">
        <property name="text">
         <string>Cut surface size:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkDoubleSpinBox" name="extensionSpinBox">
        <property name="toolTip">
         <string>How far the planned cut surface reaches out of the bone (and into it when the cut depth is "Through").
Typical: "Automatic" (the bone's size), which always cuts through. Limit the cut with the cut depth and the cut reach beyond the line instead.
Technical: sheet extent along the extrusion direction, and past the line ends when that is automatic.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="maximum">
         <double>10000.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.extension</string>
        </property>
       <property name="specialValueText"><string>Automatic</string></property></widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="minFragmentFractionLabel">
        <property name="text">
         <string>Discard loose bits smaller than:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="ctkDoubleSpinBox" name="minFragmentFractionSpinBox">
        <property name="toolTip">
         <string>Loose bits of bone with fewer points than this percentage of the bone are discarded (specks). Bits inside the bone (canal, marrow) are always kept.
Typical: 0.1 %.
Technical: minFragmentFraction, stored as a fraction of the model's points.</string>
        </property>
        <property name="decimals"><number>2</number></property><property name="singleStep"><double>0.05</double></property><property name="maximum"><double>50.0</double></property><property name="suffix"><string> %</string></property></widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="refineEdgeLengthLabel">
        <property name="text">
         <string>Surface detail at the cut:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="ctkDoubleSpinBox" name="refineEdgeLengthSpinBox">
        <property name="toolTip">
         <string>The bone surface near the cut is refined to this detail so that the cut surfaces are accurate.
Typical: "Automatic" (half the saw blade thickness).
Technical: maximum edge length near the cutting sheet before cutting.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>options.refineEdgeLength</string>
        </property>
       <property name="specialValueText"><string>Automatic</string></property></widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="solidVoxelSizeLabel">
        <property name="text">
         <string>Solid model detail:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="ctkDoubleSpinBox" name="solidVoxelSizeSpinBox">
        <property name="toolTip">
         <string>Size of the smallest detail kept in solid bone models. Finer needs more memory; a model too large for the detail is refused with a suggested value.
Typical: 0.25 mm for a mandible, 0.4-0.5 mm for a whole skull.
Technical: voxel size of the solid model.</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="minimum">
         <double>0.050000000000000</double>
        </property>
        <property name="maximum">
         <double>5.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>solidVoxelSize</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="solidGapSealLabel">
        <property name="text">
         <string>Solid model gap sealing:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="ctkDoubleSpinBox" name="solidGapSealSpinBox">
        <property name="toolTip">
         <string>Holes and gaps in the bone surface up to about twice this width are sealed in solid bone models. Larger values also fill narrow gaps between bones and sharp notches (e.g. between teeth).
Typical: 1.5 mm.
Technical: radius of the morphological closing.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="suffix">
         <string> mm</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>solidGapSeal</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="minSegmentPercentLabel">
        <property name="text">
         <string>Join pieces smaller than:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="ctkDoubleSpinBox" name="minSegmentPercentSpinBox">
        <property name="toolTip">
         <string>Loose pieces left between the cuts (e.g. bits of the pterygoid plates, or of thin sinus and nasal walls) with less surface than this percentage of the largest bone segment are joined to the bone segment they touch most, so that only the planned segments remain.
Typical: 1 %; 0 keeps every piece as its own bone segment.
Technical: pieces are appended to the large segment with most points within the blade thickness + 1 mm.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="maximum">
         <double>50.000000000000000</double>
        </property>
        <property name="suffix">
         <string> %</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>minSegmentPercent</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="applyButtonsLayout">
     <item>
      <widget class="QPushButton" name="applyButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>Cuts the bone along the osteotomy line(s) and creates the bone segments. The bone model is checked first, and you are warned about structures that are too close.
Typical: after checking the preview.
Technical: applies all lines of the osteotomy in order.</string>
       </property>
       <property name="text">
        <string>Make cut</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="undoButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>Removes the bone segments made by the selected osteotomy and shows its bone again.
Typical: to change the plan and cut again.
Technical: deletes the segments linked to the osteotomy's first line.</string>
       </property>
       <property name="text">
        <string>Undo this cut</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text">
      <string />
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="mergeCollapsibleButton">
     <property name="text">
      <string>Rejoin bone segments</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QHBoxLayout" name="mergeLayout">
      <item>
       <widget class="qMRMLCheckableNodeComboBox" name="mergeFragmentsSelector">
        <property name="toolTip">
         <string>Tick two or more bone segments from the same cut to join them into one.
Typical: to undo an unwanted cut, e.g. on the opposite side.
Technical: the segments are appended into one model.</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLModelNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="mergeButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Joins the ticked bone segments into one model.
Typical: two or more segments of the same cut.
Technical: mesh append; the lowest-numbered segment keeps its name and colour.</string>
        </property>
        <property name="text">
         <string>Rejoin selected bone segments</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
