<!-- Part of OsteotomyCuts, a 3D Slicer extension. See LICENSE and DISCLAIMER.md. -->
<ui version="4.0">
 <class>DisclaimerDialog</class>
 <widget class="QDialog" name="DisclaimerDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>460</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Osteotomy Cuts: terms of use</string>
  </property>
  <property name="modal">
   <bool>true</bool>
  </property>
  <layout class="QVBoxLayout" name="disclaimerLayout">
   <item>
    <widget class="QTextBrowser" name="disclaimerTextBrowser">
     <property name="openExternalLinks">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="acceptCheckBox">
     <property name="text">
      <string>I have read and accept these terms</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="disclaimerButtonsLayout">
     <item>
      <spacer name="disclaimerButtonsSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="acceptButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="text">
        <string>Accept</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="closeButton">
       <property name="text">
        <string>Close</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>acceptCheckBox</sender>
   <signal>toggled(bool)</signal>
   <receiver>acceptButton</receiver>
   <slot>setEnabled(bool)</slot>
  </connection>
  <connection>
   <sender>acceptButton</sender>
   <signal>clicked()</signal>
   <receiver>DisclaimerDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>closeButton</sender>
   <signal>clicked()</signal>
   <receiver>DisclaimerDialog</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
</ui>
